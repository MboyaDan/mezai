# Copy to backend/.env.staging (git-ignored) for scripts/staging.sh.
# Never commit the filled-in copy. See docs/deployment.md, step 4.
# This file is read by the shell: put values with spaces or symbols in single
# quotes, e.g. SETUP_ADMIN_NAME='Jane Admin'.

# Supabase session pooler (Connect > Session pooler), with these options added:
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require&pool_max_conns=5

# First Super Admin (scripts/staging.sh setup). Delete the password line after.
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_NAME=
SETUP_ADMIN_PASSWORD=

# Sample data on staging (scripts/staging.sh seed). The repository is public,
# so the built-in sample password is public too: use your own, 16+ characters.
SEED_PASSWORD=

# Where backups go (outside the repository)
# BACKUP_DIR=$HOME/mezai-backups
