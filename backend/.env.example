# Copy to backend/.env for local development. Never commit .env.
# Values here are for local development only.

APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=text

# Host ports used by docker compose (5433 avoids a local PostgreSQL on 5432)
API_PORT=8080
POSTGRES_PORT=5433
S3_PORT=8333
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# PostgreSQL (compose service)
POSTGRES_USER=mezai
POSTGRES_PASSWORD=mezai_dev_only
POSTGRES_DB=mezai
# Used by `go run`, `make test` and `make migrate` from the host
DATABASE_URL=postgres://mezai:mezai_dev_only@localhost:5433/mezai?sslmode=disable

# Object storage (SeaweedFS locally; R2 or Supabase Storage in staging)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=mezai-dev
S3_ACCESS_KEY_ID=mezai_dev_key
S3_SECRET_ACCESS_KEY=mezai_dev_secret_only
S3_USE_PATH_STYLE=true

# Sign-in password for every sample user created by `make seed`
# (development and test only; defaults to sample-password-only)
# SEED_PASSWORD=

# Browser-facing site origin; state-changing requests from elsewhere are refused
APP_ORIGIN=http://localhost:3000
# Keep true: browsers accept Secure cookies on http://localhost
COOKIE_SECURE=true
# Proxies whose X-Forwarded-For is trusted (the Next.js dev server is local)
TRUSTED_PROXIES=127.0.0.1,::1
# Absolute session lifetime and idle sign-out
SESSION_TTL=168h
SESSION_IDLE=48h

# First Super Admin, created by `make setup` (any environment; remove the
# password from the environment afterwards)
# SETUP_ADMIN_EMAIL=
# SETUP_ADMIN_NAME=
# SETUP_ADMIN_PASSWORD=

# Outgoing email. Locally mailpit catches everything (UI on MAILPIT_UI_PORT).
# MAIL_FROM is required outside development and test.
SMTP_ADDR=localhost:1025
MAIL_FROM=MezAI <no-reply@mezai.invalid>
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Project enquiries from the public contact form are emailed here.
# Required outside development and test (defaults to ops@mezai.invalid locally).
ENQUIRY_NOTIFY_TO=ops@mezai.invalid
# Cloudflare Turnstile on public forms, behind DG-07. Leave empty to keep it off;
# set it together with NEXT_PUBLIC_TURNSTILE_SITE_KEY in the frontend.
# TURNSTILE_SECRET_KEY=
