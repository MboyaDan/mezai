# Copy to frontend/.env.local. Server-side only; never exposed to the browser.
# Where the /api/* rewrite forwards requests (the Go API).
API_ORIGIN=http://localhost:8080

# Public site address, for canonical links, the sitemap and Open Graph images.
SITE_URL=http://localhost:3000
# Set to 1 only in production. Anything else sends noindex and a robots.txt
# that disallows everything, so local and staging stay out of search.
SITE_INDEXABLE=0

# Cloudflare Turnstile site key (public), behind DG-07. Empty keeps the widget
# off. Set it only together with TURNSTILE_SECRET_KEY on the API.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
